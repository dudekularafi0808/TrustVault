# ==============================================================================
# TRUSTVAULT ZERO-TRUST SECURITY PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in your project root to configure your database
# and connect your real email service for password resets & security alerts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Supabase / PostgreSQL Cloud Database (Recommended)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Option B: Built-in SQLite (Default - zero setup required)
# Uses 'trustvault.db' located in the project directory.
#
# Option C: Custom Database File Location (e.g. mounted disk, volume, custom folder)
# DATABASE_PATH=/var/data/trustvault.db
# DATABASE_PATH=C:/data/trustvault.db
#
# Option D: Custom Uploads Storage Directory
# UPLOADS_DIR=uploads


# ------------------------------------------------------------------------------
# 2. EMAIL (SMTP) CONFIGURATION - CONNECT TO YOUR MAIL
# ------------------------------------------------------------------------------
# Connect your real email inbox so password reset codes and security notices
# are delivered directly to actual user email addresses.
#
# --- GMAIL CONFIGURATION GUIDE ---
# 1. Go to your Google Account (myaccount.google.com) -> Security
# 2. Enable "2-Step Verification"
# 3. Go to "App Passwords" (myaccount.google.com/apppasswords)
# 4. Generate an app password named "TrustVault" (Google creates a 16-character code)
# 5. Set SMTP_SERVER=smtp.gmail.com and SMTP_PASSWORD=<your-16-character-code>
#
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_SENDER=TrustVault Security <your_email@gmail.com>
SMTP_USE_TLS=true

# --- ALTERNATIVE MAIL PROVIDERS ---
#
# Outlook / Office 365:
# SMTP_SERVER=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@outlook.com
# SMTP_PASSWORD=your_outlook_password
#
# SendGrid:
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
#
# Mailgun:
# SMTP_SERVER=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@your-domain.mailgun.org
# SMTP_PASSWORD=your_mailgun_smtp_password
#
# Amazon SES:
# SMTP_SERVER=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=your_ses_smtp_user
# SMTP_PASSWORD=your_ses_smtp_password
